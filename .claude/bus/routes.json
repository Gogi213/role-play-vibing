{"rules": [
 {"match": "задача.*.задание.готово", "to": ["dispatcher"], "hold": ["dispatcher"]},
 {"match": "задача.*.задание.упало", "to": ["dispatcher", "ceo"], "hold": ["dispatcher"]},
 {"match": "задача.*.сдано", "to": ["dispatcher"], "hold": ["dispatcher"]},
 {"match": "задача.*.статус", "to": ["dispatcher"], "hold": ["dispatcher"]},
 {"match": "задача.*.к_ceo", "to": ["ceo"]},
 {"match": "задача.*.вопрос_владельцу", "to": ["ceo"]},
 {"match": "машина.*.юнит.остановлен", "to": ["dispatcher"]},
 {"match": "машина.*.юнит.упал", "to": ["dispatcher", "ceo"]},
 {"match": "машина.*.файл.появился", "to": ["dispatcher"]},
 {"match": "сборка.*", "to": ["dispatcher"]},
 {"match": "служба.не_обработано", "to": ["ceo"]}
]}
