{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_context.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_context.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/role_memory.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
